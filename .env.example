# Copy to .env (gitignored); scripts/run-local.sh loads it.
# Every variable is documented in doc/INSTALLATION.md#configuration.

# Required
YOUTUBE_API_KEY=your-api-key-here

# Optional, shown with their defaults
YARRTUBE_PORT=8080
YARRTUBE_RETRY_BASE_DELAY_SECONDS=150
YARRTUBE_DOWNLOAD_CONCURRENCY=2
RUST_LOG=info

# SponsorBlock: empty disables removal; default removes all skippable categories
# except filler tangents. Use all to include filler, or e.g. sponsor,selfpromo.
YARRTUBE_SPONSORBLOCK_REMOVE=

# Paths. run-local.sh keeps the database and videos under the repo root,
# and uses the yt-dlp on your PATH unless YTDLP_PATH is set here.
# YARRTUBE_DB_PATH=yarrtube.sqlite3
# YARRTUBE_AVATARS_PATH=avatars
# YARRTUBE_VIDEOS_PATH=/path/to/videos
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Plex scan trigger (see doc/PLEX.md); enabled only when all three are set.
# YARRTUBE_PLEX_URL=http://192.168.1.10:32400
# YARRTUBE_PLEX_TOKEN=your-plex-token
# YARRTUBE_PLEX_VIDEOS_PATH=/volume1/data/media/yarrtube

# Subtitles use upstream's separate original-language fetch task: creator captions
# first, original automatic captions as fallback. Caption failures never fail videos.
# Embed by default; keep the external SRT for web playback and transcripts too.
YARRTUBE_EMBED_SUBS=true
# Legacy YARRTUBE_WRITE_SUBS, YARRTUBE_WRITE_AUTO_SUBS and YARRTUBE_SUB_LANGS
# are ignored; remove them from existing container configurations when convenient.

# scripts/run-spa-against-remote.sh: the daemon whose library the local web UI
# browses, read-only unless --allow-writes is passed.
# YARRTUBE_REMOTE_URL=http://192.168.1.142:8080
