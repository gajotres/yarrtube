#!/usr/bin/env -S deno run --allow-read --allow-write --allow-env
// The stand-in yt-dlp the end-to-end suite's daemon runs (YTDLP_PATH), answering
// each way the daemon calls yt-dlp (src/infrastructure/shared/ytdlp.rs) from
// catalogue.json and ../samples/, the way the YouTube contract tests show the
// real one does. Every video is the same sample clip; a `slow` video takes
// ~8 s to download and a `failing` one always fails, with a transient reason
// so the daemon retries it.

const CATALOGUE = JSON.parse(Deno.readTextFileSync(new URL('./catalogue.json', import.meta.url)))
const SAMPLES = new URL('../samples/', import.meta.url)
const SLOW_DOWNLOAD_MS = 8_000
const FAILURE_REASON = 'Unable to download video data: HTTP Error 503: Service Unavailable'
// How long a `failing` download takes to fail, so its retries can be seen.
const FAILING_ATTEMPT_MS = 2_000

const args = Deno.args
const has = (flag) => args.includes(flag)
const valueOf = (flag) => args[args.indexOf(flag) + 1]
const url = args.at(-1)

function videoOf(videoUrl) {
  const id = new URL(videoUrl).searchParams.get('v')
  const video = CATALOGUE.videos.find((candidate) => candidate.id === id)
  if (!video) {
    fail(`[youtube] ${id}: Video unavailable`)
  }
  return video
}

function fail(reason) {
  console.error(`ERROR: ${reason}`)
  Deno.exit(1)
}

function failIfBroken(video) {
  if (video.behaviour === 'failing') {
    fail(`[youtube] ${video.id}: ${FAILURE_REASON}`)
  }
}

function timestamp(video) {
  return Math.floor(Date.parse(video.publishedAt) / 1000)
}

function uploadDate(video) {
  return video.publishedAt.slice(0, 10).replaceAll('-', '')
}

function copySample(extension, target) {
  Deno.copyFileSync(new URL(`${CATALOGUE.sample}.${extension}`, SAMPLES), target)
}

// `--flat-playlist --print-json -I 1:<limit> <channel>/videos`: the channel's
// newest videos, one JSON object per line.
function listChannel() {
  const handle = new URL(url).pathname.split('/')[1].toLowerCase()
  const channel = CATALOGUE.channels.find((candidate) => candidate.handle.toLowerCase() === handle)
  if (!channel) {
    fail(`[youtube:tab] ${handle}: This channel does not exist.`)
  }
  const limit = Number(valueOf('-I').split(':')[1])
  for (const id of channel.videos.slice(0, limit)) {
    const video = CATALOGUE.videos.find((candidate) => candidate.id === id)
    const liveStatus = video.liveBroadcastContent === 'upcoming' ? 'is_upcoming' : null
    console.log(JSON.stringify({ id, title: video.title, live_status: liveStatus }))
  }
}

// `--load-info-json <info.json> … --sub-langs <key> --convert-subs srt`: the
// probed video's subtitles, as `<id>.<key>.srt`.
function fetchSubtitles() {
  const info = JSON.parse(Deno.readTextFileSync(valueOf('--load-info-json')))
  const key = valueOf('--sub-langs')
  Deno.copyFileSync(new URL(CATALOGUE.subtitles, SAMPLES), `${info.id}.${key}.srt`)
}

// `-J --skip-download --write-subs`: the info JSON, with uploaded English
// subtitles.
function probeCaptions() {
  const video = videoOf(url)
  failIfBroken(video)
  console.log(
    JSON.stringify({
      id: video.id,
      title: video.title,
      language: 'en',
      timestamp: timestamp(video),
      upload_date: uploadDate(video),
      subtitles: { en: [{ ext: 'vtt', name: 'English' }] },
      automatic_captions: {},
    }),
  )
}

// `--simulate …`: no output for a video that would download, the error for
// one that wouldn't.
function diagnose() {
  failIfBroken(videoOf(url))
}

// `--skip-download --write-thumbnail …`: `<id>.jpg`, printing the publish time
// and the thumbnail's path.
function fetchThumbnail() {
  const video = videoOf(url)
  failIfBroken(video)
  copySample('jpg', `${video.id}.jpg`)
  console.log(timestamp(video))
  console.log(uploadDate(video))
  console.log(`${video.id}.jpg`)
}

// The download: `<id>.mp4` and `<id>.jpg`, printing the publish time, the
// duration and the media's filename.
async function download() {
  const video = videoOf(url)
  const delay = { slow: SLOW_DOWNLOAD_MS, failing: FAILING_ATTEMPT_MS }[video.behaviour]
  if (delay) {
    await new Promise((resolve) => setTimeout(resolve, delay))
  }
  failIfBroken(video)
  copySample('mp4', `${video.id}.mp4`)
  copySample('jpg', `${video.id}.jpg`)
  console.log(timestamp(video))
  console.log(uploadDate(video))
  console.log(video.durationSeconds)
  console.log(`${video.id}.mp4`)
}

if (has('--flat-playlist')) {
  listChannel()
} else if (has('--load-info-json')) {
  fetchSubtitles()
} else if (has('-J')) {
  probeCaptions()
} else if (has('--simulate')) {
  diagnose()
} else if (has('--skip-download')) {
  fetchThumbnail()
} else {
  await download()
}
